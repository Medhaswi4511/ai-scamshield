{
  "manifest_version": 3,

  "name": "AI ScamShield",

  "version": "1.0",

  "description":
    "AI-powered phishing and scam detection extension.",

  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "notifications",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker":
      "background.js"
  },

  "action": {
    "default_popup":
      "popup.html"
  },

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}